# Copy this file to `.env.dev` or `.env.prod` and adjust the values.
#
# Development defaults
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production
DATABASE_URL=sqlite:///phishaware.db
EMAIL_PROVIDER=mailtrap
MAILTRAP_USERNAME=your_mailtrap_username
MAILTRAP_PASSWORD=your_mailtrap_password
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=587
SENDER_EMAIL=your_sender_email@example.com
SENDER_NAME=Your Security Training Team
SERVER_URL=http://localhost:5000
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Strict

# Production defaults
# FLASK_ENV=production
# SECRET_KEY=replace-with-a-long-random-secret
# DATABASE_URL=sqlite:////app/instance/phishaware.db
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=your_sendgrid_api_key
# SENDER_EMAIL=security-training@example.com
# SENDER_NAME=Security Training Team
# SERVER_URL=https://your-public-app-url.example.com
# SESSION_COOKIE_SECURE=True
# SESSION_COOKIE_HTTPONLY=True
# SESSION_COOKIE_SAMESITE=Strict
